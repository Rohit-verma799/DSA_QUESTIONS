#include<bits/stdc++.h>
using namespace std;
// any end arbitary swap not allowed
int minSwap1(vector<int> &nums){
    int leftEnd = 0;
    int rightEnd = 0;
    int ones = 0;
    int ones1 = 0;
    int n = nums.size()-1;
    
    for(int i = 0; i<nums.size(); i++){
        if(nums[i] == 1){
            ones++;
        }else{
            leftEnd += ones;
        }
        
        if(nums[n-i] == 1){
            ones1++;
        }else{
            rightEnd += ones1;
        }
    }
    return min(leftEnd, rightEnd);
}

arbitary swap allowed
int minSwap(vector<int> &nums){
    int ones = 0;
    for(int i = 0; i<nums.size(); i++){
        if(nums[i] == 1){
            ones++;
        }
    }
    
    int left = 0;
    for(int i = 0; i<ones; i++){
        if(nums[i] == 0){
            left++;
        }
    }
    int n = nums.size();
    int right = 0;
    for(int i = n - ones; i<nums.size(); i++){
        if(nums[i] == 0){
            right++;
        }
    }
    return min(left, right);
}

// need to group the ones
class Solution {
  public:
    int minSwaps(vector<int>& arr) {
        int k = 0;
        for(int x : arr){
            if(x == 1){
                k++;
            }
        }
        if(k == 0) return -1;
        
        int curr = 0;
        for(int i = 0; i<k; i++){
            curr += arr[i];
        }
        
        int maxOne = curr;
        for(int i = k; i<arr.size(); i++){
            curr += arr[i];
            curr -= arr[i - k];
            maxOne = max(curr, maxOne);
        }
        return k - maxOne;
    }
};



int main(){
    vector<int> vec = {1,0,1,0,0,1};
    cout << minSwap(vec);
}
